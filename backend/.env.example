PORT=4200
# Идентичность: x-session (вход huEVO) или x-device-id (UUID). DEV_AUTH=true — фолбэк без заголовка.
DEV_AUTH=true
ADMIN_KEY=admin123
# Файл состояния игроков (балансы, история)
DATA_FILE=data.json

# huEVO Apps API (ключи из настроек приложения). Без них: device-режим + демо-пополнение.
HUEVO_CLIENT_ID=
HUEVO_CLIENT_SECRET=
# Секрет сессионных токенов (если пусто — выводится из HUEVO_CLIENT_SECRET)
SESSION_SECRET=
